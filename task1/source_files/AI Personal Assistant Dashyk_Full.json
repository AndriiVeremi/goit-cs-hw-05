    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let text = item.json.output || item.json.response || \"\";\n\n  // Видаляємо символи, які ламають MarkdownV2, крім переносів рядків\n  text = text.replace(/[*_[\\]()<>~`#+\\-=|{}.!]/g, '');\n\n  // Розбиваємо текст на окремі листи за \"Від \"\n  let lines = text.split('Від ').filter(Boolean);\n\n  let formatted = lines.map(line => {\n    // Розділяємо на відправника, тему та тіло\n    let parts = line.split('\"');\n    if(parts.length >= 2){\n      let sender = parts[0].trim();\n      let subject = parts[1].trim();\n      let body = parts.slice(2).join('\"').trim();\n\n      // Форматуємо\n      return `📧 *${sender}*: *\"${subject}\"*\\n${body}`;\n    }\n    return line;\n  }).join('\\n\\n'); // додаємо пропуск між листами\n\n  return { json: { cleanedText: formatted } };\n});\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
